<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- test code is allowed to be looser than shipping code -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1998;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- Platform-neutral core is compiled straight into the test assembly: no Windows needed to run the suite. -->
  <ItemGroup>
    <Compile Include="..\..\src\TransparentNotepad\Transcription\*.cs" />
    <Compile Include="..\..\src\TransparentNotepad\Ai\*.cs" />
    <Compile Include="..\..\src\TransparentNotepad\Session\*.cs" />
    <Compile Include="..\..\src\TransparentNotepad\Logging\*.cs" />
  </ItemGroup>

</Project>
